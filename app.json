{
  "expo": {
    "name": "diafacil",
    "slug": "diafacil",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "diafacil",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#121116"
          },
          "android": {
            "drawable": {
              "icon": "./assets/splash/splashscreen_logo.xml"
            }
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que DiaFacil escanee el QR de tu agenda.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "push": {
        "enabled": false,
        "androidChannelId": "diafacil-cuidador-v1"
      },
      "router": {},
      "eas": {
        "projectId": "1795613d-b14f-45f4-947a-96dabcbf71a0"
      }
    },
    "owner": "jhonatanvasquez"
  }
}
