# Example only: use the computer's LAN IP for a physical phone.
# Copy to .env.local and adjust. Never include HMAC or SMTP credentials.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080

# Push stays off until you configure real Firebase/EAS projects.
EXPO_PUBLIC_PUSH_ENABLED=false
# EAS_PROJECT_ID must be your real project UUID (public), never a made-up value.
# GOOGLE_SERVICES_JSON is a local/EAS file path, never the service account private key.
